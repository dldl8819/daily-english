{
  "name": "daily-english",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "questions": "node scripts/ensure-questions.mjs",
    "questions:report": "node scripts/question-report.mjs",
    "questions:batch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/questions-batch.mjs",
    "predev": "npm run questions",
    "dev": "next dev",
    "prebuild": "npm run questions",
    "build": "next build",
    "start": "next start",
    "pretest": "npm run questions",
    "test": "vitest run",
    "check:bundle": "node scripts/check-bundle.mjs",
    "prebuild:ait": "npm run questions",
    "build:ait": "next build && node scripts/check-bundle.mjs && ait build",
    "deploy": "ait deploy"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "3.8.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@apps-in-toss/devtools": "3.8.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
