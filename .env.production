# 광고 그룹 ID는 번들에 그대로 들어가는 공개 값이라 비밀이 아니다.

# 메인_하단배너 (BANNER · NORMAL, 2026-10-21 생성)
NEXT_PUBLIC_AIT_BANNER_AD_GROUP_ID=ait.v2.live.63b019ef11964236

# 서버 API 주소 (server/ 배포 후 채운다). 넣고 빌드하면 문제 은행이 번들에서 빠지고 문제를 서버에서 받는다.
# NEXT_PUBLIC_API_BASE_URL=https://english-bite-api.<계정>.workers.dev

