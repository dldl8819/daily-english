# .dev.vars로 복사해서 쓴다 (.dev.vars는 저장소에 올리지 않는다).
# 로컬 Supabase(npx supabase start)의 API URL과 Secret key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
# 32자 이상 임의 문자열. 예: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# localhost 요청에서 토스 인증 코드 교환 없이 개발용 사용자로 로그인한다. 운영에는 넣지 않는다.
DEV_AUTH=true
